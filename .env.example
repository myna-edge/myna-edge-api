# Default local: sqlite — leave MYNA_STORAGE unset
# MYNA_STORAGE=sqlite

# Cloudflare deploy uses D1 via wrangler.toml (MYNA_STORAGE=d1 + DB binding)

# Optional Turso instead of D1
# MYNA_STORAGE=turso
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Ingest auth — recommended when public
# MYNA_INGEST_TOKEN=dev-ingest-token

# Protect webhook settings writes (optional). When set, web must use VITE_MYNA_ADMIN_TOKEN.
# MYNA_ADMIN_TOKEN=dev-admin-token

# PORT=8787
