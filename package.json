{
  "name": "myna-edge-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/storage"
  ],
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "deploy": "wrangler deploy",
    "cf:typegen": "wrangler types"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "D1 数据库绑定（变量名必须为 `DB`）。Deploy 按钮会按 `wrangler.toml` 自动创建/绑定名为 `myna-edge` 的库。"
      }
    }
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@myna-edge/storage": "*",
    "hono": "^4.9.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  }
}
